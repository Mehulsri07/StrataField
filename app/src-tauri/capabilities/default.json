{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DATA/Strata/**"
        }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart"
  ]
}
